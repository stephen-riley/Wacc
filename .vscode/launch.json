    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Launch (console)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/bin/Debug/net11.0/Wacc.dll",
            "args": "fixtures/book_tests/chapter_8/valid/extra_credit/duffs_device.c -o tmp/bob/a --asmfile tmp/bob/a.S --verbose",
            // "args": "test -c 8 --stage emit --all --extra-credit --fail-fast", // --fail-fast --verbose
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "internalConsole",
            "env": {
                "WACC_TESTS_PATH": "~/Projects/writing-a-c-compiler-tests/"
            }
        },
        {
            "name": "Debug /tmp/a.out",
            "type": "lldb",
            "request": "launch",
            "cwd": "${workspaceFolder}/tmp/bob",
            "program": "${workspaceFolder}/tmp/bob/a",
            "args": [],
            "stopOnEntry": true
        }
    ]
}